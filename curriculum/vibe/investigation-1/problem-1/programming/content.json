            {
              "id": "jbxNuNlnSdnnjRzG",
              "title": "Designing an Improvement",
              "fixedPosition": true,
              "content": {
                "type": "Text",
                "format": "html",
                "text": [
                  "<p>How will you improve your prototype? You can...</p><p>1. Write your ideas</p><p>2. Sketch your ideas using the sketch tile</p><p>3. Draw your ideas on paper and take a picture</p>"
                ]
              }
